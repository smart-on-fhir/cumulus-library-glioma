-- Target Genetic Test information of interest includes 
-- - braf_altered: bool | None
-- - braf_v600e: b:ool | None
-- - braf_fusion: bool | None
-- - idh_mutant: bool | None
-- - h3k27m_mutant: bool | None
-- - tp53_altered: bool | None
-- - cdkn2a_deleted: bool | None
--  Pass to get braf_altered --
SELECT
    src.note_ref,
    src.subject_ref,
    src.generated_on,
    src.task_version,
    src.system_fingerprint,
    '{{ table_name }}' AS origin,
    'Genetic Test Results' AS label,
    CONCAT(CAST(span[1] AS VARCHAR), ':', CAST(span[2] AS VARCHAR)) AS span,
    'Genetic Test - braf_altered' AS sublabel_name,
    CAST(genetic_test.braf_altered AS VARCHAR) AS sublabel_value
FROM 
    {{ table_name }} AS src,
    UNNEST(src.result.target_genetic_test_mention) AS t1(genetic_test),
    UNNEST(
        COALESCE(
            genetic_test.spans, 
            CAST(ARRAY[ARRAY[]] AS ARRAY(ARRAY(INTEGER)))
        )
    ) AS t2(span)
WHERE 
    genetic_test.braf_altered IS NOT NULL
    AND genetic_test.braf_altered 
