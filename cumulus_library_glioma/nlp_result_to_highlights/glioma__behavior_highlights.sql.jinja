# Behavior information of interest is the code since we use an internally defined enum
SELECT
    src.note_ref,
    src.subject_ref,
    src.generated_on,
    src.task_version,
    src.system_fingerprint,
    '{{ table_name }}' AS origin,
    'Behavior' AS label,
    CONCAT(CAST(span[1] AS VARCHAR), ':', CAST(span[2] AS VARCHAR)) AS span,
    'Behavior' AS sublabel_name,
    CAST(src.result.behavior_mention.code AS VARCHAR) AS sublabel_value
FROM 
    {{ table_name }} AS src, 
    UNNEST(src.result.behavior_mention.code) AS t3(span)
WHERE
    src.result.behavior_mention.code IS NOT NULL
    AND src.result.behavior_mention.code 
